# Application Info
APP_NAME=multi-tenant-app
DESCRIPTION=Multi-Tenant Application Example
VERSION=0.1.0

# Environment
ENV=dev
DEBUG=True

# TENANCY
TENANCY_CONFIG_PROVIDER=file
TENANT_CONFIG_FILE_PATH=tenants_config.json

TENANT_SECRET_FILE_PATH=tenants_secrets.json
TENANT_SECRET_PROVIDER=file

USER_DATA_PROVIDER=header
USER_ID_HEADER_NAME=X-User-Id
JWT_VALIDATE=false
JWT_SECRET=
JWT_ALGORITHM=HS256

# AWS Secrets Manager (only if using TENANT_SECRET_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Workers
WORKERS=2
