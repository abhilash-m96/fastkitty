# Application Info
APP_NAME=fastkitty
DESCRIPTION=fastkitty multi-tenant service template
VERSION=0.1.0

# Environment
ENV=dev
DEBUG=True

# TENANCY
TENANCY_CONFIG_CONNECTION='{"type": "file", "file_path": "tenants_config.json"}'
TENANCY_SECRETS_CONNECTION='{"type": "file", "file_path": "tenants_secrets.json"}'
TENANCY_DB_STRATEGY=database
TENANCY_DATABASE_MAX_ENGINES=50

# USER IDENTITY & UPSTREAM AUTH DATA SOURCE
# Option 1: Gateway Headers (Default)
USER_DATA_SOURCE='{"type": "header", "user_id_header": "X-User-ID", "user_email_header": "X-User-Email", "user_roles_header": "X-User-Roles", "roles_delimiter": ","}'

# Option 2: JWT Claims from Authorization Bearer token (trusted internal network, unverified payload decode)
# Standard:
# USER_DATA_SOURCE='{"type": "jwt", "header_name": "Authorization", "prefix": "Bearer", "user_id_claim": "sub", "user_email_claim": "email", "user_roles_claim": "roles", "tenant_id_claim": "tenant_id", "require_tenant_claim": true}'
# Auth0 / WorkOS (org_id):
# USER_DATA_SOURCE='{"type": "jwt", "tenant_id_claim": "org_id", "require_tenant_claim": true}'
# Nested claims path (e.g. Auth0 app_metadata, Supabase user_metadata):
# USER_DATA_SOURCE='{"type": "jwt", "tenant_id_claim": "app_metadata.tenant_id", "require_tenant_claim": true}'

# Option 3: Serialized JSON Claims Header
# USER_DATA_SOURCE='{"type": "claims", "header_name": "X-User-Claims", "user_id_field": "id", "user_email_field": "email", "user_roles_field": "roles", "tenant_id_field": "tenant_id", "require_tenant_claim": true}'
# Nested claims path:
# USER_DATA_SOURCE='{"type": "claims", "tenant_id_field": "metadata.org_id", "require_tenant_claim": true}'

# Upstream Auth Production Guard:
# Required to be true when USER_DATA_SOURCE is configured and ENV != 'dev'.
# Guarantees an upstream API Gateway strips forged client headers before requests reach FastKitty.
TRUST_UPSTREAM_AUTH=false

# Reject JWT or Claims tokens that lack a tenant claim matching X-Tenant-ID
# (Checks configured tenant_id_claim / tenant_id_field, falling back to tenant_id / tid / tenant)
REQUIRE_TENANT_CLAIM=false

# Logfire / Telemetry
LOGFIRE_ENABLED=true
LOGFIRE_CAPTURE_HEADERS=false
LOGFIRE_SEND_TO_LOGFIRE=false
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=fastkitty
LOGFIRE_ENVIRONMENT=dev
LOGFIRE_CONSOLE=true

# Workers
WORKERS=2

