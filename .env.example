# Application Info
APP_NAME=fastkitty
DESCRIPTION=fastkitty multi-tenant service template
VERSION=0.1.0

# Environment
ENV=dev
DEBUG=True

# TENANCY
TENANCY_CONFIG_CONNECTION='{"type": "file", "file_path": "tenants_config.json"}'
TENANCY_SECRETS_CONNECTION='{"type": "file", "file_path": "tenants_secrets.json"}'
TENANCY_DB_STRATEGY=database
TENANCY_DATABASE_MAX_ENGINES=50

USER_DATA_SOURCE='{"type": "header", "user_id_header": "X-User-ID"}'

# Logfire / Telemetry
LOGFIRE_ENABLED=true
LOGFIRE_SEND_TO_LOGFIRE=false
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=fastkitty
LOGFIRE_ENVIRONMENT=dev
LOGFIRE_CONSOLE=true

# Workers
WORKERS=2
